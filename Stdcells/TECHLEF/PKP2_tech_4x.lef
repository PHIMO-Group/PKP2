  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.32 PRL -0.002 CUTCLASS PKP2_V10 PKP2_V10 0.32 0.002 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_V10 BELOW HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_V10 ABOVE HORIZONTAL 0 VERTICAL 0 ;" ;
END V10

LAYER M11
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.64 ;
  OFFSET 0.0 ;
  WIDTH 0.32 ;
  MINWIDTH 0.32 ;
  # Engineering P&R AREA: PKP3E width-normalized grouping, with local via floor.
  AREA 0.2048 ;
  # M11_S_2, M11_S_3 and M11_AUX_1
  SPACING 0.18 ;
  # M11_S_1/S_2: all-width side/tip tables for PRL>0.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DIRECTIONALSPANLENGTH PRL 0 SPANLENGTH 0 0.32 ; SPACINGTABLE DIRECTIONALSPANLENGTH WRONGDIRECTION PRL 0 SPANLENGTH 0 0.2 ;" ;
  # Ungated M11_S_1 also checks diagonal corners; combined limit exceeds S_3.
  PROPERTY LEF58_CORNERSPACING "CORNERSPACING CONVEXCORNER CORNERTOCORNER WIDTH 0 SPACING 0.32 ;" ;
  PROPERTY LEF58_RECTONLY "RECTONLY ;" ;
  PROPERTY LEF58_RIGHTWAYONGRIDONLY "RIGHTWAYONGRIDONLY ;" ;
END M11

LAYER V11
