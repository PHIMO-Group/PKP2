# PKP2 V1.04 DRC semantic alignment, 2026-10-13.
# M1 routing PITCH stays 28nm (112nm at4x); cell M1 columns stay42nm.
# M0-M13 corner spacing is Euclidean CORNERTOCORNER, not MAXXY.
# Engineering AREA, array pitches and BSC conservative spacing are retained.
VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
USEMINSPACING OBS OFF ;
CLEARANCEMEASURE EUCLIDEAN ;

PROPERTYDEFINITIONS
  LAYER LEF58_BACKSIDE STRING ;
  LAYER LEF58_PITCH STRING ;
  LAYER LEF58_CUTCLASS STRING ;
  LAYER LEF58_SPACINGTABLE STRING ;
  LAYER LEF58_ENCLOSURE STRING ;
  LAYER LEF58_CORNERSPACING STRING ;
  LAYER LEF58_RECTONLY STRING ;
  LAYER LEF58_RIGHTWAYONGRIDONLY STRING ;
  LAYER LEF58_TYPE STRING ;
  LAYER LEF58_SPACING STRING ;
  LAYER LEF58_WIDTH STRING ;
END PROPERTYDEFINITIONS

UNITS
  DATABASE MICRONS 2000 ;
END UNITS
MANUFACTURINGGRID 0.002 ;

SITE CoreSite
  SIZE 0.168 BY 0.376 ;
  CLASS CORE ;
  SYMMETRY Y ;
END CoreSite

LAYER OVERLAP
  TYPE OVERLAP ;
END OVERLAP

LAYER BSM3
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 4.32 ;
  OFFSET 0.0 ;
  WIDTH 2.16 ;
  MINWIDTH 2.16 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 4.6656 ;
  SPACING 2.16 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM3

LAYER BSV3
  TYPE CUT ;
  SPACING 0.64 ;
  WIDTH 0.64 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSV3 WIDTH 0.64 CUTS 1 ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.64 CUTCLASS PKP2_BSV3 PKP2_BSV3 0.64 0.64 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSV3 ABOVE HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_BSV3 BELOW HORIZONTAL 0 VERTICAL 0.08 ;" ;
END BSV3

LAYER BSM2
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 1.28 ;
  OFFSET 0.0 ;
  WIDTH 0.64 ;
  MINWIDTH 0.64 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 0.4096 ;
  SPACING 0.64 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM2

LAYER BSV2
  # BSV2_BSM2_EN_1 measures Y enclosure. BELOW is BSM2 in this stack.
  TYPE CUT ;
  SPACING 0.336 ;
  WIDTH 0.336 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSV2 WIDTH 0.336 CUTS 1 ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.336 CUTCLASS PKP2_BSV2 PKP2_BSV2 0.336 0.336 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSV2 ABOVE HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_BSV2 BELOW HORIZONTAL 0 VERTICAL 0.04 ;" ;
END BSV2

LAYER BSM1
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.72 ;
  OFFSET 0.0 ;
  WIDTH 0.336 ;
  MINWIDTH 0.336 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 0.112896 ;
  SPACING 0.336 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM1

LAYER BSV1
  TYPE CUT ;
  SPACING 0.256 ;
  WIDTH 0.256 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSV1 WIDTH 0.256 CUTS 1 ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.256 CUTCLASS PKP2_BSV1 PKP2_BSV1 0.256 0.256 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSV1 ABOVE HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_BSV1 BELOW HORIZONTAL 0 VERTICAL 0.02 ;" ;
END BSV1

LAYER BSM0
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.376 ;
  OFFSET 0.0 ;
  WIDTH 0.256 ;
  MINWIDTH 0.256 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 0.065536 ;
  SPACING 0.12 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM0

LAYER BSC
  TYPE CUT ;
  # BSC_S_1/BSC_S_2: conservative maximum of directional spacing limits.
  SPACING 0.104 ;
  WIDTH 0.06 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSC WIDTH 0.06 LENGTH 0.064 CUTS 1 ORIENT HORIZONTAL ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.104 CUTCLASS PKP2_BSC PKP2_BSC 0.104 0.104 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSC BELOW HORIZONTAL 0 VERTICAL 0.012 ;" ;
  # BSC_W_1/W_2: 16nm horizontal, 15nm vertical; CT-side connectivity stays in signoff.
END BSC

# BSC_SRAM is defined in the SRAM physical/signoff views, not in the P&R stack.

LAYER M0
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.084 ;
  OFFSET 0.062 ;
  WIDTH 0.044 ;
  MINWIDTH 0.044 ;
  # M0_W_2 and M0_A_1: 0.044 x 0.1 is the conservative P&R area.
  AREA 0.0044 ;
  SPACING 0.04 ;
  # M0_S_1/S_2: all-width side/tip tables for PRL>0.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DIRECTIONALSPANLENGTH PRL 0 SPANLENGTH 0 0.04 ; SPACINGTABLE DIRECTIONALSPANLENGTH WRONGDIRECTION PRL 0 SPANLENGTH 0 0.072 ;" ;
  PROPERTY LEF58_CORNERSPACING "CORNERSPACING CONVEXCORNER CORNERTOCORNER WIDTH 0 SPACING 0.04 ;" ;
  PROPERTY LEF58_RECTONLY "RECTONLY ;" ;
  PROPERTY LEF58_RIGHTWAYONGRIDONLY "RIGHTWAYONGRIDONLY ;" ;
  # Four M0 tracks repeat per 94nm base row; cross-row center spacing is 31nm.
  PROPERTY LEF58_PITCH "PITCH 0.084 FIRSTLASTPITCH 0.062 ;" ;
END M0

LAYER V0
  # V0_S_1: corner spacing in strictly negative-PRL table entry;
  # PRL>0 uses one manufacturing-grid guard, not a DRC edge minimum.
  TYPE CUT ;
  SPACING 0.002 ;
  WIDTH 0.044 ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_V0 WIDTH 0.044 LENGTH 0.056 CUTS 1 ORIENT HORIZONTAL ;" ;
  # Unclassified via sizes retain a conservative full-spacing fallback.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.044 PRL -0.002 CUTCLASS PKP2_V0 PKP2_V0 0.044 0.002 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_V0 BELOW HORIZONTAL 0.012 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_V0 ABOVE HORIZONTAL 0 VERTICAL 0.012 ;" ;
END V0

LAYER M1
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.112 ;
  OFFSET 0.056 ;
  WIDTH 0.056 ;
  MINWIDTH 0.056 ;
  # M1_A_1, M1_S_2, M1_S_3 and M1_AUX_1
  AREA 0.008064 ;
  SPACING 0.056 ;
  # M1_S_1/S_2: all-width side/tip tables for PRL>0.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DIRECTIONALSPANLENGTH PRL 0 SPANLENGTH 0 0.056 ; SPACINGTABLE DIRECTIONALSPANLENGTH WRONGDIRECTION PRL 0 SPANLENGTH 0 0.056 ;" ;
  PROPERTY LEF58_CORNERSPACING "CORNERSPACING CONVEXCORNER CORNERTOCORNER WIDTH 0 SPACING 0.096 ;" ;
  PROPERTY LEF58_RECTONLY "RECTONLY ;" ;
