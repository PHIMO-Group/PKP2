  # Unclassified via sizes retain a conservative full-spacing fallback.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.04 PRL -0.002 CUTCLASS PKP2_V1 PKP2_V1 0.04 0.002 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_V1 BELOW HORIZONTAL 0 VERTICAL 0.02 ; ENCLOSURE CUTCLASS PKP2_V1 ABOVE HORIZONTAL 0.02 VERTICAL 0 ;" ;
END V1

