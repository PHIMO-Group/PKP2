  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_V1 WIDTH 0.011 LENGTH 0.014 CUTS 1 ORIENT HORIZONTAL ;" ;
  # Unclassified via sizes retain a conservative full-spacing fallback.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.01 PRL -0.0005 CUTCLASS PKP2_V1 PKP2_V1 0.01 0.0005 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_V1 BELOW HORIZONTAL 0 VERTICAL 0.005 ; ENCLOSURE CUTCLASS PKP2_V1 ABOVE HORIZONTAL 0.005 VERTICAL 0 ;" ;
END V1

