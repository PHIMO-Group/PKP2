# PKP2 V1.04 DRC semantic alignment, 2026-10-13.
# M1 routing PITCH stays 28nm (112nm at4x); cell M1 columns stay42nm.
# M0-M13 corner spacing is Euclidean CORNERTOCORNER, not MAXXY.
# Engineering AREA, array pitches and BSC conservative spacing are retained.
VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
USEMINSPACING OBS OFF ;
CLEARANCEMEASURE EUCLIDEAN ;

PROPERTYDEFINITIONS
  LAYER LEF58_BACKSIDE STRING ;
  LAYER LEF58_PITCH STRING ;
  LAYER LEF58_CUTCLASS STRING ;
  LAYER LEF58_SPACINGTABLE STRING ;
  LAYER LEF58_ENCLOSURE STRING ;
  LAYER LEF58_CORNERSPACING STRING ;
  LAYER LEF58_RECTONLY STRING ;
  LAYER LEF58_RIGHTWAYONGRIDONLY STRING ;
  LAYER LEF58_TYPE STRING ;
  LAYER LEF58_SPACING STRING ;
  LAYER LEF58_WIDTH STRING ;
END PROPERTYDEFINITIONS

UNITS
  DATABASE MICRONS 2000 ;
END UNITS
MANUFACTURINGGRID 0.0005 ;

SITE CoreSite
  SIZE 0.042 BY 0.094 ;
  CLASS CORE ;
  SYMMETRY Y ;
END CoreSite

LAYER OVERLAP
  TYPE OVERLAP ;
END OVERLAP

LAYER BSM3
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 1.08 ;
  OFFSET 0.0 ;
  WIDTH 0.54 ;
  MINWIDTH 0.54 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 0.2916 ;
  SPACING 0.54 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM3

LAYER BSV3
  TYPE CUT ;
  SPACING 0.16 ;
  WIDTH 0.16 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSV3 WIDTH 0.16 CUTS 1 ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.16 CUTCLASS PKP2_BSV3 PKP2_BSV3 0.16 0.16 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSV3 ABOVE HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_BSV3 BELOW HORIZONTAL 0 VERTICAL 0.02 ;" ;
END BSV3

LAYER BSM2
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.32 ;
  OFFSET 0.0 ;
  WIDTH 0.16 ;
  MINWIDTH 0.16 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 0.0256 ;
  SPACING 0.16 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM2

LAYER BSV2
  # BSV2_BSM2_EN_1 measures Y enclosure. BELOW is BSM2 in this stack.
  TYPE CUT ;
  SPACING 0.084 ;
  WIDTH 0.084 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSV2 WIDTH 0.084 CUTS 1 ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.084 CUTCLASS PKP2_BSV2 PKP2_BSV2 0.084 0.084 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSV2 ABOVE HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_BSV2 BELOW HORIZONTAL 0 VERTICAL 0.01 ;" ;
END BSV2

LAYER BSM1
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.18 ;
  OFFSET 0.0 ;
  WIDTH 0.084 ;
  MINWIDTH 0.084 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 0.007056 ;
  SPACING 0.084 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM1

LAYER BSV1
  TYPE CUT ;
  SPACING 0.064 ;
  WIDTH 0.064 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSV1 WIDTH 0.064 CUTS 1 ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.064 CUTCLASS PKP2_BSV1 PKP2_BSV1 0.064 0.064 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSV1 ABOVE HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_BSV1 BELOW HORIZONTAL 0 VERTICAL 0.005 ;" ;
END BSV1

LAYER BSM0
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.094 ;
  OFFSET 0.0 ;
  WIDTH 0.064 ;
  MINWIDTH 0.064 ;
  # Engineering P&R AREA: square minimum-width backside landing pad.
  AREA 0.004096 ;
  SPACING 0.03 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
END BSM0

LAYER BSC
  TYPE CUT ;
  # BSC_S_1/BSC_S_2: conservative maximum of directional spacing limits.
  SPACING 0.026 ;
  WIDTH 0.015 ;
  PROPERTY LEF58_BACKSIDE "BACKSIDE ;" ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_BSC WIDTH 0.015 LENGTH 0.016 CUTS 1 ORIENT HORIZONTAL ;" ;
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.026 CUTCLASS PKP2_BSC PKP2_BSC 0.026 0.026 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_BSC BELOW HORIZONTAL 0 VERTICAL 0.003 ;" ;
  # BSC_W_1/W_2: 16nm horizontal, 15nm vertical; CT-side connectivity stays in signoff.
END BSC

# BSC_SRAM is defined in the SRAM physical/signoff views, not in the P&R stack.

LAYER M0
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.021 ;
  OFFSET 0.0155 ;
  WIDTH 0.011 ;
  MINWIDTH 0.011 ;
  # M0_W_2 and M0_A_1: 0.011 x 0.025 is the conservative P&R area.
  AREA 0.000275 ;
  SPACING 0.01 ;
  # M0_S_1/S_2: all-width side/tip tables for PRL>0.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DIRECTIONALSPANLENGTH PRL 0 SPANLENGTH 0 0.01 ; SPACINGTABLE DIRECTIONALSPANLENGTH WRONGDIRECTION PRL 0 SPANLENGTH 0 0.018 ;" ;
  PROPERTY LEF58_CORNERSPACING "CORNERSPACING CONVEXCORNER CORNERTOCORNER WIDTH 0 SPACING 0.01 ;" ;
  PROPERTY LEF58_RECTONLY "RECTONLY ;" ;
  PROPERTY LEF58_RIGHTWAYONGRIDONLY "RIGHTWAYONGRIDONLY ;" ;
  # Four M0 tracks repeat per 94nm base row; cross-row center spacing is 31nm.
  PROPERTY LEF58_PITCH "PITCH 0.021 FIRSTLASTPITCH 0.0155 ;" ;
END M0

LAYER V0
  # V0_S_1: corner spacing in strictly negative-PRL table entry;
  # PRL>0 uses one manufacturing-grid guard, not a DRC edge minimum.
  TYPE CUT ;
  SPACING 0.0005 ;
  WIDTH 0.011 ;
  PROPERTY LEF58_CUTCLASS "CUTCLASS PKP2_V0 WIDTH 0.011 LENGTH 0.014 CUTS 1 ORIENT HORIZONTAL ;" ;
  # Unclassified via sizes retain a conservative full-spacing fallback.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.011 PRL -0.0005 CUTCLASS PKP2_V0 PKP2_V0 0.011 0.0005 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_V0 BELOW HORIZONTAL 0.003 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_V0 ABOVE HORIZONTAL 0 VERTICAL 0.003 ;" ;
END V0

LAYER M1
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.028 ;
  OFFSET 0.014 ;
  WIDTH 0.014 ;
  MINWIDTH 0.014 ;
  # M1_A_1, M1_S_2, M1_S_3 and M1_AUX_1
  AREA 0.000504 ;
  SPACING 0.014 ;
  # M1_S_1/S_2: all-width side/tip tables for PRL>0.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DIRECTIONALSPANLENGTH PRL 0 SPANLENGTH 0 0.014 ; SPACINGTABLE DIRECTIONALSPANLENGTH WRONGDIRECTION PRL 0 SPANLENGTH 0 0.014 ;" ;
  PROPERTY LEF58_CORNERSPACING "CORNERSPACING CONVEXCORNER CORNERTOCORNER WIDTH 0 SPACING 0.024 ;" ;
  PROPERTY LEF58_RECTONLY "RECTONLY ;" ;
END M1

