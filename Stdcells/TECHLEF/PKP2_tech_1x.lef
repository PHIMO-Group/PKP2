  PITCH 0.021 ;
  OFFSET 0.0 ;
  WIDTH 0.011 ;
  MINWIDTH 0.011 ;
  # Engineering P&R AREA: PKP3E width-normalized grouping, with local via floor.
  AREA 0.000504 ;
