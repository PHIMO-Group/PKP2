  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DEFAULT 0.08 PRL -0.0005 CUTCLASS PKP2_V10 PKP2_V10 0.08 0.0005 ;" ;
  PROPERTY LEF58_ENCLOSURE "ENCLOSURE CUTCLASS PKP2_V10 BELOW HORIZONTAL 0 VERTICAL 0 ; ENCLOSURE CUTCLASS PKP2_V10 ABOVE HORIZONTAL 0 VERTICAL 0 ;" ;
END V10

LAYER M11
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.16 ;
  OFFSET 0.0 ;
  WIDTH 0.08 ;
  MINWIDTH 0.08 ;
  # Engineering P&R AREA: PKP3E width-normalized grouping, with local via floor.
  AREA 0.0128 ;
  # M11_S_2, M11_S_3 and M11_AUX_1
  SPACING 0.045 ;
  # M11_S_1/S_2: all-width side/tip tables for PRL>0.
  PROPERTY LEF58_SPACINGTABLE "SPACINGTABLE DIRECTIONALSPANLENGTH PRL 0 SPANLENGTH 0 0.08 ; SPACINGTABLE DIRECTIONALSPANLENGTH WRONGDIRECTION PRL 0 SPANLENGTH 0 0.05 ;" ;
  # Ungated M11_S_1 also checks diagonal corners; combined limit exceeds S_3.
  PROPERTY LEF58_CORNERSPACING "CORNERSPACING CONVEXCORNER CORNERTOCORNER WIDTH 0 SPACING 0.08 ;" ;
  PROPERTY LEF58_RECTONLY "RECTONLY ;" ;
  PROPERTY LEF58_RIGHTWAYONGRIDONLY "RIGHTWAYONGRIDONLY ;" ;
END M11

LAYER V11
