 ( display      y9                   blank      solid      silver     silver     outline   )
 ( display      y9Flt                blank      solid      silver     silver     outline   )
)
drDefineColor(
;( DisplayName   ColorsName   Red      Green    Blue     )
 ( psc           white        255      255      255      )
 ( psc           yellow       255      255      0        )
)
drDefineStipple(
;( DisplayName   StippleName  Bitmap     )
)
drDefineLineStyle(
;( DisplayName   LineStyle    Size       Pattern   )
 ( psc           solid        1          (1 1 1 ) )
)
drDefinePacket(
;( DisplayName  PacketName           Stipple    LineStyle  Fill       Outline    [FillStyle])
 ( psc          defaultPacket        blank      solid      white      yellow     outline   )
)
